# IP-only deploy (no custom domain). Copy to .env on the Droplet.
# Replace secrets. Do NOT commit .env.
#
# HTTP-only (celulares pueden forzar HTTPS y fallar — ver deploy/DUCKDNS-HTTPS.md):
#   PUBLIC_APP_URL=http://vitobet.duckdns.org
#   PUBLIC_API_URL=http://vitobet.duckdns.org:8000
#   CORS_ORIGINS=http://vitobet.duckdns.org
#
# HTTPS recomendado (docker-compose.duckdns.yml + nginx):
#   APP_DOMAIN=vitobet.duckdns.org
#   PUBLIC_APP_URL=https://vitobet.duckdns.org
#   PUBLIC_API_URL=https://vitobet.duckdns.org/api
#   CORS_ORIGINS=https://vitobet.duckdns.org

APP_DOMAIN=vitobet.duckdns.org

PUBLIC_APP_URL=http://vitobet.duckdns.org
PUBLIC_API_URL=http://vitobet.duckdns.org:8000
CORS_ORIGINS=http://vitobet.duckdns.org

POSTGRES_USER=vitobet
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=vitobet

SECRET_KEY=CHANGE_ME_LONG_JWT_SECRET
CRON_SECRET=CHANGE_ME_CRON_SECRET

GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-secret

PRIZE_POOL_LABEL="Vitobet Pool 2026"
PRIZE_POOL_AMOUNT_USD="-"
