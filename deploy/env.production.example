# Copy to repo root as .env on the Droplet:
#   cp deploy/env.production.example .env
#   nano .env

# --- Domains (A records → Droplet IP) ---
APP_DOMAIN=vitobet.example.com
API_DOMAIN=api.vitobet.example.com

# Public URLs (https, no trailing slash) — used by frontend build + CORS
PUBLIC_APP_URL=https://vitobet.example.com
PUBLIC_API_URL=https://api.vitobet.example.com
CORS_ORIGINS=https://vitobet.example.com

# --- Postgres ---
POSTGRES_USER=vitobet
POSTGRES_PASSWORD=change-me-long-random-password
POSTGRES_DB=vitobet

# --- App secrets ---
SECRET_KEY=change-me-long-random-secret-for-jwt
CRON_SECRET=change-me-cron-secret

# --- Google OAuth (same client as local dev) ---
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional
PRIZE_POOL_LABEL=Vitobet Pool 2026
PRIZE_POOL_AMOUNT_USD=—
SSL_EMAIL=you@example.com
